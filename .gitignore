sae_data/

# ── Model checkpoints (regenerate with train/) ───────────────────────────────
# All consolidated under checkpoints/<experiment>/
checkpoints/

# ── Run / experiment outputs ─────────────────────────────────────────────────
out/
vpd_out/

# ── Run logs & local scratch ─────────────────────────────────────────────────
logs/
scratchpad/
*.log

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Local editor / agent config ──────────────────────────────────────────────
.claude/
.vscode/
.DS_Store

# Isolated venv for causalnex/DYNOTEARS baseline (numpy<1.24, pandas<2.0)
.venv_causalnex/
.venv/

# Compat symlink to this repo itself (old ~/savar-project path; remove later)
savar-project
