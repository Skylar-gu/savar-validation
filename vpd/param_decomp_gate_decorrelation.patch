--- /dev/null
+++ b/param_decomp/metrics/gate_decorrelation.py
@@ -0,0 +1,57 @@
+from typing import Literal, override
+
+import torch
+from jaxtyping import Float
+from pydantic import NonNegativeFloat
+from torch import Tensor
+
+from param_decomp.metrics.base import LossMetricConfig, Metric, MetricResult
+from param_decomp.metrics.context import MetricContext
+
+
+class GateDecorrelationLossConfig(LossMetricConfig):
+    """Anti-redundancy penalty: pairwise Pearson correlation between component gates.
+
+    For each decomposed layer, the upper-leaky CI gates `g[..., C]` are flattened over
+    all leading (batch, position) dims to `(N, C)`, column-centered/normalized, and the
+    mean squared off-diagonal correlation is penalized. Components whose gates co-fire
+    across samples are pushed to differentiate (or die — ImportanceMinimality decides).
+    """
+
+    type: Literal["GateDecorrelationLoss"] = "GateDecorrelationLoss"
+    eps: NonNegativeFloat = 1e-8
+
+
+def _mean_sq_offdiag_corr(g: Float[Tensor, "... C"], eps: float) -> Float[Tensor, ""]:
+    G = g.reshape(-1, g.shape[-1]).float()
+    G = G - G.mean(dim=0, keepdim=True)
+    G = G / (G.norm(dim=0, keepdim=True) + eps)
+    R = G.T @ G
+    C = R.shape[0]
+    off = R - torch.diag_embed(torch.diagonal(R))
+    return (off**2).sum() / (C * (C - 1))
+
+
+class GateDecorrelationLoss(Metric[GateDecorrelationLossConfig]):
+    """Sum over decomposed layers of the mean squared off-diagonal gate correlation."""
+
+    log_namespace = "loss"
+    short_name = "GateDecor"
+
+    @override
+    def reset(self) -> None:
+        self.total = torch.zeros((), device=self.device)
+        self.n_batches = torch.zeros((), device=self.device, dtype=torch.long)
+
+    @override
+    def update(self, ctx: MetricContext) -> Tensor:
+        loss = torch.zeros((), device=self.device)
+        for g in ctx.ci.upper_leaky.values():
+            loss = loss + _mean_sq_offdiag_corr(g, self.cfg.eps)
+        self.total += loss.detach()
+        self.n_batches += 1
+        return loss
+
+    @override
+    def compute(self) -> MetricResult:
+        return self.total / self.n_batches.clamp(min=1)
